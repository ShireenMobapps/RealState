    <scenes>
        <!--Agent Tab Bar Controller-->
        <scene sceneID="scene-agent-tab">
            <objects>
                <tabBarController storyboardIdentifier="AgentTabBarController" id="agent-tab" customClass="AgentTabBarController" customModule="AIPoweredRealEstate" customModuleProvider="target" sceneMemberID="viewController">
                    <tabBar key="tabBar" contentMode="scaleToFill" id="tb-agent">
                        <rect key="frame" x="0.0" y="803" width="393" height="49"/>
                        <autoresizingMask key="autoresizingMask"/>
                        <color key="backgroundColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                    </tabBar>
                    <connections>
                        <segue destination="nav-ahome" kind="relationship" relationship="viewControllers" id="seg-tab-home"/>
                        <segue destination="nav-asearch" kind="relationship" relationship="viewControllers" id="seg-tab-search"/>
                        <segue destination="nav-asaved" kind="relationship" relationship="viewControllers" id="seg-tab-saved"/>
                        <segue destination="nav-aprofile" kind="relationship" relationship="viewControllers" id="seg-tab-profile"/>
                    </connections>
                </tabBarController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="fr-agent-tab" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="-780" y="0.0"/>
        </scene>
        <!--Home-->
        <scene sceneID="scene-nav-ahome">
            <objects>
                <navigationController navigationBarHidden="YES" id="nav-ahome" sceneMemberID="viewController">
