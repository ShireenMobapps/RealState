                    <navigationBar key="navigationBar" hidden="YES" contentMode="scaleToFill" id="nb-nav-ahome">
                        <autoresizingMask key="autoresizingMask"/>
                    </navigationBar>
                    <connections>
                        <segue destination="vc-ahome" kind="relationship" relationship="rootViewController" id="seg-nav-ahome"/>
                    </connections>
                </navigationController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="fr-nav-ahome" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="20" y="-720"/>
        </scene>
        <!--Inventory-->
