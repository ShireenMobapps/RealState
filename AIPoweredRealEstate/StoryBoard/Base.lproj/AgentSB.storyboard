                        <outlet property="listedByLabel" destination="lb-listed" id="o-listed"/>
                        <outlet property="locationLabel" destination="lb-loc" id="o-loc"/>
                        <outlet property="marketingButton" destination="btn-mkt-ad" id="o-mkt-ad"/>
                        <outlet property="photoView" destination="img-adet" id="o-photo-ad"/>
                        <outlet property="priceLabel" destination="lb-price" id="o-price"/>
                        <outlet property="reportButton" destination="btn-rep-ad" id="o-rep-ad"/>
                        <outlet property="specsLabel" destination="lb-specs" id="o-specs"/>
                        <outlet property="summaryLabel" destination="lb-sum" id="o-sum"/>
                        <outlet property="titleLabel" destination="lb-title" id="o-title"/>
                        <outlet property="typeLabel" destination="lb-type" id="o-type"/>
                    </connections>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="fr-adet" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="2420" y="0.0"/>
        </scene>
        <!--Client report-->
        <scene sceneID="scene-arep">
            <objects>
                <viewController storyboardIdentifier="AgentReportVC" id="vc-arep" customClass="AgentReportVC" customModule="AIPoweredRealEstate" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="view-arep">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <textField opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="left" contentVerticalAlignment="center" placeholder="Select a client" textAlignment="natural" minimumFontSize="17" translatesAutoresizingMaskIntoConstraints="NO" id="tf-client" customClass="CustomTextField" customModule="AIPoweredRealEstate" customModuleProvider="target">
                                <rect key="frame" x="20" y="75" width="353" height="36"/>
                                <constraints>
                                    <constraint firstAttribute="height" constant="36" id="tf-client-h"/>
                                </constraints>
                                <fontDescription key="fontDescription" type="system" pointSize="12"/>
                                <textInputTraits key="textInputTraits"/>
                                <userDefinedRuntimeAttributes>
                                    <userDefinedRuntimeAttribute type="number" keyPath="cornerRadious">
                                        <real key="value" value="12"/>
                                    </userDefinedRuntimeAttribute>
                                    <userDefinedRuntimeAttribute type="number" keyPath="leftPadding">
                                        <real key="value" value="14"/>
                                    </userDefinedRuntimeAttribute>
                                </userDefinedRuntimeAttributes>
                            </textField>
                            <scrollView clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="scaleToFill" keyboardDismissMode="onDrag" translatesAutoresizingMaskIntoConstraints="NO" id="scrl-rep">
                                <rect key="frame" x="20" y="139" width="353" height="597"/>
                                <subviews>
                                    <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="card-rep" customClass="CustomView" customModule="AIPoweredRealEstate" customModuleProvider="target">
                                        <rect key="frame" x="0.0" y="0.0" width="353" height="120"/>
                                        <subviews>
                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="" lineBreakMode="tailTruncation" numberOfLines="0" translatesAutoresizingMaskIntoConstraints="NO" id="lb-body-rep">
                                                <rect key="frame" x="16" y="16" width="321" height="88"/>
                                                <fontDescription key="fontDescription" type="system" pointSize="15"/>
                                                <color key="textColor" red="0.12941176470588237" green="0.14509803921568629" blue="0.16078431372549021" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                                <nil key="highlightedColor"/>
                                            </label>
                                        </subviews>
                                        <color key="backgroundColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                        <constraints>
                                            <constraint firstItem="lb-body-rep" firstAttribute="top" secondItem="card-rep" secondAttribute="top" constant="16" id="br1"/>
                                            <constraint firstItem="lb-body-rep" firstAttribute="leading" secondItem="card-rep" secondAttribute="leading" constant="16" id="br2"/>
                                            <constraint firstAttribute="trailing" secondItem="lb-body-rep" secondAttribute="trailing" constant="16" id="br3"/>
                                            <constraint firstAttribute="bottom" secondItem="lb-body-rep" secondAttribute="bottom" constant="16" id="br4"/>
                                            <constraint firstAttribute="height" relation="greaterThanOrEqual" constant="120" id="card-rep-h"/>
                                        </constraints>
                                    </view>
                                </subviews>
                                <constraints>
                                    <constraint firstItem="card-rep" firstAttribute="top" secondItem="scrl-rep" secondAttribute="top" id="scr1"/>
                                    <constraint firstItem="card-rep" firstAttribute="leading" secondItem="scrl-rep" secondAttribute="leading" id="scr2"/>
                                    <constraint firstItem="card-rep" firstAttribute="trailing" secondItem="scrl-rep" secondAttribute="trailing" id="scr3"/>
                                    <constraint firstItem="card-rep" firstAttribute="bottom" secondItem="scrl-rep" secondAttribute="bottom" constant="-8" id="scr4"/>
                                    <constraint firstItem="card-rep" firstAttribute="width" secondItem="scrl-rep" secondAttribute="width" id="scr5"/>
                                </constraints>
                            </scrollView>
                            <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="btn-share-rep" customClass="CustomButton" customModule="AIPoweredRealEstate" customModuleProvider="target">
                                <rect key="frame" x="20" y="752" width="353" height="50"/>
                                <constraints>
                                    <constraint firstAttribute="height" constant="50" id="btn-share-rep-h"/>
                                </constraints>
                                <state key="normal" title="Share report">
                                    <color key="titleColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                </state>
                                <userDefinedRuntimeAttributes>
                                    <userDefinedRuntimeAttribute type="number" keyPath="cornerRadious">
                                        <real key="value" value="14"/>
                                    </userDefinedRuntimeAttribute>
                                </userDefinedRuntimeAttributes>
                                <connections>
                                    <action selector="shareTapped:" destination="vc-arep" eventType="touchUpInside" id="act-share-rep"/>
                                </connections>
                            </button>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="safe-arep"/>
                        <color key="backgroundColor" red="0.98039215686274506" green="0.97647058823529409" blue="0.96470588235294119" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="tf-client" firstAttribute="top" secondItem="safe-arep" secondAttribute="top" constant="16" id="rp1"/>
                            <constraint firstItem="safe-arep" firstAttribute="bottom" secondItem="btn-share-rep" secondAttribute="bottom" constant="16" id="rp10"/>
                            <constraint firstItem="tf-client" firstAttribute="leading" secondItem="safe-arep" secondAttribute="leading" constant="20" id="rp2"/>
                            <constraint firstItem="safe-arep" firstAttribute="trailing" secondItem="tf-client" secondAttribute="trailing" constant="20" id="rp3"/>
                            <constraint firstItem="scrl-rep" firstAttribute="top" secondItem="tf-client" secondAttribute="bottom" constant="16" id="rp4"/>
                            <constraint firstItem="scrl-rep" firstAttribute="leading" secondItem="tf-client" secondAttribute="leading" id="rp5"/>
                            <constraint firstItem="scrl-rep" firstAttribute="trailing" secondItem="tf-client" secondAttribute="trailing" id="rp6"/>
                            <constraint firstItem="btn-share-rep" firstAttribute="top" secondItem="scrl-rep" secondAttribute="bottom" constant="16" id="rp7"/>
                            <constraint firstItem="btn-share-rep" firstAttribute="leading" secondItem="tf-client" secondAttribute="leading" id="rp8"/>
                            <constraint firstItem="btn-share-rep" firstAttribute="trailing" secondItem="tf-client" secondAttribute="trailing" id="rp9"/>
                        </constraints>
                    </view>
                    <navigationItem key="navigationItem" title="Client report" id="ni-arep"/>
                    <connections>
                        <outlet property="bodyLabel" destination="lb-body-rep" id="o-body-rep"/>
                        <outlet property="clientField" destination="tf-client" id="o-client"/>
                        <outlet property="reportCardView" destination="card-rep" id="o-rcard-rep"/>
                        <outlet property="shareButton" destination="btn-share-rep" id="o-share-rep"/>
                    </connections>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="fr-arep" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="2420" y="720"/>
        </scene>
        <!--Lead-->
        <scene sceneID="scene-aleadd">
            <objects>
                <viewController storyboardIdentifier="AgentLeadDetailVC" id="vc-aleadd" customClass="AgentLeadDetailVC" customModule="AIPoweredRealEstate" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="view-aleadd">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" spacing="16" translatesAutoresizingMaskIntoConstraints="NO" id="st-ldd">
                                <rect key="frame" x="20" y="79" width="353" height="50"/>
                                <subviews>
                                    <segmentedControl hidden="YES" opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="left" contentVerticalAlignment="top" segmentControlStyle="plain" selectedSegmentIndex="0" translatesAutoresizingMaskIntoConstraints="NO" id="seg-status">
                                        <rect key="frame" x="0.0" y="0.0" width="353" height="35"/>
                                        <constraints>
                                            <constraint firstAttribute="height" constant="0" id="seg-status-h"/>
                                        </constraints>
                                        <segments>
                                            <segment title="New"/>
                                            <segment title="Contacted"/>
                                            <segment title="Viewing"/>
                                            <segment title="Closed"/>
                                        </segments>
                                    </segmentedControl>
                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="" lineBreakMode="tailTruncation" numberOfLines="0" translatesAutoresizingMaskIntoConstraints="NO" id="lb-ldd">
                                        <rect key="frame" x="0.0" y="50" width="353" height="0.0"/>
                                        <fontDescription key="fontDescription" type="system" pointSize="16"/>
                                        <color key="textColor" red="0.12941176470588237" green="0.14509803921568629" blue="0.16078431372549021" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                        <nil key="highlightedColor"/>
                                    </label>
                                </subviews>
                            </stackView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="safe-aleadd"/>
                        <color key="backgroundColor" red="0.98039215686274506" green="0.97647058823529409" blue="0.96470588235294119" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="st-ldd" firstAttribute="top" secondItem="safe-aleadd" secondAttribute="top" constant="20" id="ldd1"/>
                            <constraint firstItem="st-ldd" firstAttribute="leading" secondItem="safe-aleadd" secondAttribute="leading" constant="20" id="ldd2"/>
                            <constraint firstItem="safe-aleadd" firstAttribute="trailing" secondItem="st-ldd" secondAttribute="trailing" constant="20" id="ldd3"/>
                        </constraints>
                    </view>
                    <navigationItem key="navigationItem" title="Lead" id="ni-aleadd"/>
                    <connections>
                        <outlet property="body" destination="lb-ldd" id="o-ldd-body"/>
                        <outlet property="status" destination="seg-status" id="o-ldd-st"/>
                    </connections>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="fr-aleadd" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="2420" y="1440"/>
        </scene>
    </scenes>
