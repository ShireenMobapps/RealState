    <scenes>
        <!--Tenant Tab Bar Controller-->
        <scene sceneID="scene-tenant-tab">
            <objects>
                <tabBarController storyboardIdentifier="TenantTabBarController" id="tenant-tab" customClass="TenantTabBarController" customModule="AIPoweredRealEstate" customModuleProvider="target" sceneMemberID="viewController">
                    <tabBar key="tabBar" contentMode="scaleToFill" id="tb-tenant">
                        <rect key="frame" x="0.0" y="803" width="393" height="49"/>
                        <autoresizingMask key="autoresizingMask"/>
                        <color key="backgroundColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                        <color key="tintColor" red="0.054901960784313725" green="0.14117647058823529" blue="0.23921568627450981" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <color key="selectedImageTintColor" red="0.054901960784313725" green="0.14117647058823529" blue="0.23921568627450981" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
