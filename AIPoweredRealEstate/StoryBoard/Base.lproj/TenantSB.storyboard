                    <navigationBar key="navigationBar" hidden="YES" contentMode="scaleToFill" id="nb-thome">
                        <autoresizingMask key="autoresizingMask"/>
                    </navigationBar>
                    <connections>
                        <segue destination="vc-thome" kind="relationship" relationship="rootViewController" id="seg-home-root"/>
                    </connections>
                </navigationController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="fr-nav-thome" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="20" y="-720"/>
        </scene>
